{
  "trailingSlash": true,
  "redirects": [
    { "source": "/sql", "destination": "/sandbox/", "permanent": true },
    { "source": "/editor", "destination": "/sandbox/", "permanent": true },
    { "source": "/editor/(.*)", "destination": "/sandbox/", "permanent": true },
    { "source": "/stat", "destination": "/statistics/", "permanent": true },
    { "source": "/articles", "destination": "/sandbox/", "permanent": true },
    { "source": "/articles/(.*)", "destination": "/sandbox/", "permanent": true },
    { "source": "/guide", "destination": "/reference/", "permanent": true },
    { "source": "/practice", "destination": "/sandbox/", "permanent": true },
    { "source": "/practice/(.*)", "destination": "/sandbox/", "permanent": true },
    { "source": "/learn", "destination": "/sandbox/", "permanent": true },
    { "source": "/learn/(.*)", "destination": "/sandbox/", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(favicon.svg|og-image.png|apple-touch-icon.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
